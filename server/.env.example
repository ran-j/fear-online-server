# This env file is only required for development and testing environment
SERVICE_NAME="FEAR Online Server"
PORT=8080
APPLICATION_ENV="DEVELOPMENT"

# ProudNet game-login server (Engine.exe connects here after the web login).
# Advertised to the client in Config.xml.
LOGIN_SERVER_IP=127.0.0.1
LOGIN_SERVER_PORT=30003

# MongoDB (accounts persisted by SteamID).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fear_online

# Starting balance granted to a brand-new account.
STARTING_POINT=50000
STARTING_CASH=50000
